# =========================================================================
# CampusAnon - Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or production secrets to Git!
# =========================================================================

# 1. Supabase Cloud Database Sync (Optional)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Preferred for server-side direct operations (bypasses RLS safely on backend only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Alternatively, the public anonymous key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 2. Session Cookie HMAC Secret (Recommended for production)
# Provide a 32+ character random hex or base64 string to sign user session cookies.
# If omitted in production, an ephemeral random secret is generated per instance.
SESSION_SECRET=your_random_session_secret_32_characters_minimum

# 3. Admin Dashboard Access Secret (Optional)
# If set, calls to /api/admin/* require 'x-admin-key: <ADMIN_SECRET>' or '?admin_key=<ADMIN_SECRET>'
# ADMIN_SECRET=your_secure_admin_passphrase_here
